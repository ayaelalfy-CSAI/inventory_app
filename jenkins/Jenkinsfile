pipeline {
    agent { label "built-in" }

    tools {
        nodejs 'nodejs'
    }

    environment {
        APP_NAME          = "inventory_app"
        IMAGE_TAG         = "${BUILD_NUMBER}"
        REGISTRY          = "ayaelalfy"
        SONAR_HOST_URL    = "http://172.17.0.1:9000"
        SONAR_PROJECT_KEY = "inventory_app"
        HOST_WORKSPACE    = "/var/lib/docker/volumes/jenkins_home/_data/workspace/${JOB_NAME}"

    }

    stages {

       

        stage('Checkout') {
           steps {
               checkout scm
           }
        }

        stage('Semgrep SAST') {
         steps {
          sh '''
            docker run --rm \
              -v "${HOST_WORKSPACE}:/src" \
              returntocorp/semgrep \
              semgrep scan \
              --config=auto \
              --json \
              --output=/src/semgrep-report.json \
              /src  || true
                   
            '''   }    
    
         post {
           always {
              archiveArtifacts artifacts: 'semgrep-report.json',
                  allowEmptyArchive: true
                }
            }
        }

        stage('Check Node') {
            steps {
              sh 'node -v'
              sh 'npm -v'
             }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
          }
        }

        stage('OWASP Dependency-Check') {
            steps {
                sh '''
                    mkdir -p "${HOST_WORKSPACE}/dependency-check-report"
                    docker run --rm \
                        -v "${HOST_WORKSPACE}:/src" \
                        -v owasp-dc-data:/usr/share/dependency-check/data \
                        owasp/dependency-check:latest \
                        --scan /src \
                        --format "HTML" --format "JSON" \
                        --project "inventory_app" \
                        --out /src/dependency-check-report \
                        --failOnCVSS 7
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'dependency-check-report/**', allowEmptyArchive: true
                }
            }
        }

        stage('Unit Tests & Coverage') {
            steps {
               sh 'npm run test:cov -- --coverageReporters=lcov --ci'
            }
            post {
              always {
                 archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: true
                }
            }
        }


        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(
                        credentialsId: 'jenkins-sonar',
                        variable: 'SONAR_TOKEN'
                    )]) {
                        sh """
                            /opt/sonar-scanner/bin/sonar-scanner \\
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \\
                                -Dsonar.sources=k8s \\
                                -Dsonar.host.url=${SONAR_HOST_URL} \\
                                -Dsonar.token=\${SONAR_TOKEN} \\
                                
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${REGISTRY}/${APP_NAME}:${IMAGE_TAG} ."
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                    trivy image \\
                        --severity LOW,MEDIUM,HIGH \\
                        --exit-code 0 \\
                        --quiet \\
                        --format json \\
                        -o trivy-medium.json \\
                        ${REGISTRY}/${APP_NAME}:${IMAGE_TAG}

                    trivy image \\
                        --severity CRITICAL \\
                        --exit-code 0 \\
                        --quiet \\
                        --format json \\
                        -o trivy-critical.json \\
                        ${REGISTRY}/${APP_NAME}:${IMAGE_TAG}
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-*.json', fingerprint: true
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push ${REGISTRY}/${APP_NAME}:${IMAGE_TAG}
                        docker logout
                    """
                }
            }
        }

        stage('Update Infra (GitOps)') {
            steps {
                echo 'Updating image tag in Kubernetes manifests...'
                withCredentials([string(
                    credentialsId: 'jenkins-github',
                    variable: 'GIT_TOKEN'
                )]) {
                    sh """
                        
                        rm -rf inventory_app
                        git clone https://\$GIT_TOKEN@github.com/ayaelalfy-CSAI/inventory_app.git
                        cd inventory_app
                        git remote set-url origin https://ayaelalfy-CSAI:\$GIT_TOKEN@github.com/ayaelalfy-CSAI/inventory_app.git
                        sed -i 's|image: ${REGISTRY}/${APP_NAME}:.*|image: ${REGISTRY}/${APP_NAME}:${IMAGE_TAG}|g' k8s/app/inventory-api/deployment.yml
                        sed -i 's|image: ${REGISTRY}/${APP_NAME}:.*|image: ${REGISTRY}/${APP_NAME}:${IMAGE_TAG}|g' k8s/app/scheduler/deployment.yml
                        sed -i 's|image: ${REGISTRY}/${APP_NAME}:.*|image: ${REGISTRY}/${APP_NAME}:${IMAGE_TAG}|g' k8s/app/worker/deployment.yml
                        git config user.email "jenkins@ci.com"
                        git config user.name "Jenkins CI"
                        git add k8s/app/inventory-api/deployment.yml k8s/app/scheduler/deployment.yml k8s/app/worker/deployment.yml
                        git diff --cached --quiet || git commit -m "CI: update image tag to ${IMAGE_TAG}"
                        git push origin master
                    """
                }
            }
        }
    }

    post {
        success {
            slackSend(
                channel: '#jenkins-ci',
                color: 'good',
                message: "✅ *Pipeline SUCCESS*\n- *Job:* ${env.JOB_NAME}\n- *Build:* #${env.BUILD_NUMBER}\n- *Image:* ${env.REGISTRY}/${env.APP_NAME}:${env.IMAGE_TAG}\n- *Duration:* ${currentBuild.durationString}\n- 🔗 ${env.BUILD_URL}"
            )
            echo 'CI done! ArgoCD will deploy automatically the k8s manifests.'
        }
        failure {
            slackSend(
                channel: '#jenkins-ci',
                color: 'danger',
                message: "❌ *Pipeline FAILED*\n- *Job:* ${env.JOB_NAME}\n- *Build:* #${env.BUILD_NUMBER}\n- 🔗 ${env.BUILD_URL}"
            )
            echo 'Pipeline failed! Check the logs.'
        }
        always {
            cleanWs()
        }
    }
}
